# Скопируйте в .env (рядом с этим файлом) и заполните.

# --- База данных ---
DATABASE_URL=postgres://mentor:mentor@127.0.0.1:5432/mentor

# --- HTTP-сервер ---
MENTOR_BIND=0.0.0.0:8080
# CORS: "*" удобно для разработки; в проде — origin приложения.
CORS_ALLOW_ORIGIN=*

# --- Авторизация ---
# ОБЯЗАТЕЛЬНО заменить перед продом, минимум 32 символа.
MENTOR_JWT_SECRET=dev-only-secret-change-me-please-0123456789
MENTOR_ACCESS_TTL_SECS=900
MENTOR_REFRESH_TTL_DAYS=30

# --- Локальная LLM (llama.cpp / Ollama) ---
# URL рантайма моделей (внутри compose-сети: http://llama:8081).
LLM_BASE_URL=http://127.0.0.1:8081
# LLM_API_KEY=            # если рантайм защищён ключом (llama.cpp --api-key)
LLM_CHAT_MODEL=qwen3:4b
LLM_EMBED_MODEL=bge-m3
