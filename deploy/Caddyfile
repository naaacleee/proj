# Конфиг Caddy: автоматический HTTPS (Let's Encrypt) и проксирование API.
# Переменные берутся из .env (DOMAIN, ADMIN_EMAIL).

{
    email {$ADMIN_EMAIL}
}

{$DOMAIN:localhost} {
    encode gzip

    # Безопасность
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    # API бэкенда
    @api path /api/* /healthz /readyz
    handle @api {
        reverse_proxy backend:8080
    }

    # Корень — короткая заглушка
    handle {
        respond "Mentor API is running" 200
    }

    log {
        output stdout
    }
}
