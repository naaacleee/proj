# =============================================================
# Продакшен-конфигурация для VPS. Скопируйте в deploy/.env
# и ЗАПОЛНИТЕ все значения с пометкой "замените".
# Файл .env в git не попадает (см. .gitignore).
# =============================================================

# --- Домен (для автоматического HTTPS) ---
# Например: mentor.example.com ИЛИ myname.duckdns.org (бесплатно, см. инструкцию)
DOMAIN=mentor.example.com
# Email для уведомлений Let's Encrypt о сертификатах
ADMIN_EMAIL=you@example.com

# --- Пароль Postgres: сгенерируйте свой ---
#   openssl rand -base64 24
POSTGRES_PASSWORD=замените-на-сгенерированный-пароль

# --- Секрет подписи JWT: сгенерируйте свой (минимум 32 символа) ---
#   openssl rand -base64 48
MENTOR_JWT_SECRET=замените-на-сгенерированный-секрет

# --- Модель наставника ---
LLM_CHAT_MODEL=qwen3:4b
LLM_EMBED_MODEL=bge-m3
# Сколько потоков CPU отдать модели (обычно = число vCPU вашего VPS)
LLM_THREADS=4
# Размер контекста (меньше = экономнее память)
LLM_CONTEXT=8192
# Лимит памяти контейнера модели (подстройте под ОЗУ VPS)
LLM_MEMORY_LIMIT=3g
# Если модель НЕ запускаете (нет памяти) — раскомментируйте и укажите
# внешний рантайм (например, Ollama на ноутбуке с его адресом в интернете —
# не рекомендуется; лучше добавить ОЗУ/уменьшить модель):
# LLM_BASE_URL=http://llama:8081

# --- Логи ---
RUST_LOG=info
